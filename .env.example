# Copy to `.env` and fill in. `.env` is git-ignored and kept out of the Docker
# build context (see .dockerignore).

# REQUIRED. A strong, random session-signing secret (>= 16 chars; use 32+).
# Generate one with:  openssl rand -hex 32
# The app refuses to start on a public bind if this is missing, a CHANGE_ME
# placeholder, or shorter than 16 chars — a weak secret makes session cookies
# forgeable (anyone could mint uid.exp.HMAC and impersonate any account).
DEMOCRACHAT_SESSION_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# REQUIRED. The public hostname Caddy serves and obtains a TLS certificate for.
# The app also reads this to build the verification link (https://SITE_ADDRESS/verify).
SITE_ADDRESS=chat.example.com

# ── Email verification (signup) ──────────────────────────────────────────────
# Whether new signups must confirm their email before they can log in:
#   hard  (default) — the account is unusable until the emailed link is clicked
#   off             — no verification; accounts are usable immediately
# Hard mode REQUIRES the email key + SMTP settings below; the app fails to start
# without them, so a hard gate is never left unverifiable.
DEMOCRACHAT_EMAIL_VERIFICATION=hard

# REQUIRED for hard mode. 64 hex chars (32 bytes) — the dedicated key email
# addresses are ENCRYPTED under at rest (they are never stored in plaintext).
# Generate with:  openssl rand -hex 32
# Keep it safe and stable: lose it and stored addresses become unrecoverable.
DEMOCRACHAT_EMAIL_KEY=CHANGE_ME_run_openssl_rand_hex_32

# REQUIRED for hard mode. The SMTP submission relay that sends verification email.
# For the single-box deploy this is the host's Postfix on 587 (STARTTLS + AUTH),
# reached from the container via host.docker.internal (see docker-compose.yml).
DEMOCRACHAT_SMTP_HOST=host.docker.internal
DEMOCRACHAT_SMTP_PORT=587
DEMOCRACHAT_SMTP_USER=no-reply@ratbum.com
DEMOCRACHAT_SMTP_PASS=CHANGE_ME_mailbox_password
DEMOCRACHAT_SMTP_FROM=democrachat <no-reply@ratbum.com>
# Set to 1 only if the relay's TLS certificate name doesn't match
# DEMOCRACHAT_SMTP_HOST (e.g. an internal Postfix whose submission cert is issued
# for a different hostname). Leave empty to require a valid, matching cert.
DEMOCRACHAT_SMTP_INSECURE_TLS=
