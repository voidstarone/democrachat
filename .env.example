# Copy to `.env` and fill in. `.env` is git-ignored and kept out of the Docker
# build context (see .dockerignore).

# REQUIRED. A strong, random session-signing secret (>= 16 chars; use 32+).
# Generate one with:  openssl rand -hex 32
# The app refuses to start on a public bind if this is missing, a CHANGE_ME
# placeholder, or shorter than 16 chars — a weak secret makes session cookies
# forgeable (anyone could mint uid.exp.HMAC and impersonate any account).
DEMOCRACHAT_SESSION_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# REQUIRED. The public hostname Caddy serves and obtains a TLS certificate for.
# The app also reads this to build the verification link (https://SITE_ADDRESS/verify).
SITE_ADDRESS=chat.example.com

# ── Email verification (signup) ──────────────────────────────────────────────
# hard (default) — new signups must confirm their email before they can log in.
# off            — no verification. Hard mode REQUIRES the key + SMTP settings
# below; the app fails to start without them.
DEMOCRACHAT_EMAIL_VERIFICATION=hard

# REQUIRED for hard mode. 64 hex chars (openssl rand -hex 32) — the dedicated key
# email addresses are ENCRYPTED under at rest (never stored in plaintext).
DEMOCRACHAT_EMAIL_KEY=CHANGE_ME_run_openssl_rand_hex_32

# REQUIRED for hard mode. The full public base URL the verification link is built
# from (usually https://<SITE_ADDRESS>).
DEMOCRACHAT_BASE_URL=https://chat.example.com

# REQUIRED for hard mode. The SMTP submission relay that sends verification email
# (host's Postfix / a LAN mail host on 587, STARTTLS + AUTH).
DEMOCRACHAT_SMTP_HOST=
DEMOCRACHAT_SMTP_PORT=587
DEMOCRACHAT_SMTP_STARTTLS=true
DEMOCRACHAT_SMTP_USERNAME=no-reply@example.com
DEMOCRACHAT_SMTP_PASSWORD=CHANGE_ME_mailbox_password
DEMOCRACHAT_SMTP_FROM=democrachat <no-reply@example.com>
# Set to 1 if the relay's submission cert name doesn't match DEMOCRACHAT_SMTP_HOST.
DEMOCRACHAT_SMTP_INSECURE_TLS=
