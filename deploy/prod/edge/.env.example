# EDGE HOST config. Copy to `.env` (git-ignored) and fill in.

# REQUIRED. Public hostname Caddy serves and obtains a TLS certificate for.
# Its DNS A record must point at THIS host, and the router must forward
# 80/443 here.
SITE_ADDRESS=chat.example.com

# REQUIRED. The app host's LAN address (host:port) to reverse-proxy to. Must
# match APP_BIND on the app host.
#   e.g. 10.0.0.4:3737   or a WireGuard/tailnet address 100.x.x.x:3737
APP_UPSTREAM=10.0.0.4:3737
