# App host configuration — copy to `.env` (git-ignored) and edit. Everything the
# app needs is here.
#
#   cp .env.example .env && $EDITOR .env
#   docker compose up -d --build

# ── REQUIRED ────────────────────────────────────────────────────────────────

# A strong, random session-signing secret (>= 16 chars; use 32 bytes of hex).
#   openssl rand -hex 32
# The app refuses to boot on this (public, non-loopback) bind if it is missing, a
# CHANGE_ME placeholder, or too short. Keep it STABLE across restarts — changing
# it invalidates every live session cookie. A second app host would need the same.
DEMOCRACHAT_SESSION_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# This host's PRIVATE LAN address and port — the address your Caddy (on the other
# Pi) reverse-proxies to. Never 0.0.0.0 and never a public IP; firewall :3737 so
# only the edge host can reach it. Example for a Pi 5 at 192.168.1.5:
#   e.g. 192.168.1.5:3737 (LAN) or 100.x.x.x:3737 (WireGuard/tailnet, encrypted)
APP_BIND=192.168.1.5:3737

# Durable storage on your external drive (ext4, mounted at boot). The DB snapshot
# is small; media is the large, growing tier — both belong off the SD card.
# Create these dirs and chown them to PUID:PGID before first run (see README).
DATA_DIR=/mnt/ssd/democrachat/data
MEDIA_DIR=/mnt/ssd/democrachat/media

# ── OPTIONAL ────────────────────────────────────────────────────────────────

# The host user/group that OWNS the dirs above; the container runs as this uid so
# the bind mounts are writable. Find yours with `id -u` / `id -g` (first Ubuntu
# user is 1000:1000).
PUID=1000
PGID=1000

# Encrypt the DB snapshot at rest: 64 hex chars (openssl rand -hex 32), or leave
# blank for plaintext. If set, the file is unreadable without it — back the key up
# separately from the drive, or a drive restore is useless.
DEMOCRACHAT_DATA_KEK=

# Single box → leave 0. A federated node would set a distinct 1–65535.
DEMOCRACHAT_NODE_ID=0

# The public host (must match the edge's SITE_ADDRESS). The app uses it to build
# the verification link https://SITE_ADDRESS/verify.
SITE_ADDRESS=chat.example.com

# ── Email verification (signup) ──────────────────────────────────────────────
# hard (default) — accounts must confirm their email before they can log in.
# soft           — accounts work normally from the start (read, post, DM, join),
#                  but cannot hold the franchise until they confirm: an
#                  unconfirmed member never becomes a citizen and never votes.
#                  Keeps sign-up frictionless while still pricing the vote in
#                  confirmed identity.
#                  One exception: a server's founding cohort (the founder and
#                  whoever joins while it is still in Seed) votes from day one on
#                  trust, and has FRANCHISE_GRACE_DAYS to confirm. Miss that
#                  deadline and the vote lapses until they do — they are warned by
#                  a countdown banner throughout, and told plainly once it is gone.
# off            — no verification.
# Both hard and soft REQUIRE the key + SMTP below (the app fails to start without
# them, so a gate is never left unconfirmable — hard would lock everyone out, soft
# would silently withhold the vote from everyone).
DEMOCRACHAT_EMAIL_VERIFICATION=hard

# How long a founding member's vote stands before it must be backed by a confirmed
# address. Default 28 — the platform's membership dwell, i.e. exactly the wait the
# founding cohort is excused, so a lapse lands where they'd have qualified anyway.
# Set 0 for the strict reading: founding members still skip the wait, but hold no
# vote until they confirm. Only meaningful when verification is hard or soft.
DEMOCRACHAT_FRANCHISE_GRACE_DAYS=28

# ── Bootstrap phases (training wheels) ───────────────────────────────────────
# Citizen counts at which a server leaves Seed and reaches Sovereign. Deployment-
# wide, not votable per server — a server voting its way out of its own training
# wheels is what these exist to prevent.
#
# CHARTERING_AT moves two things at once, so read before changing it: it is both
# how large a server's founding cohort may grow (Seed members are enfranchised on
# arrival, no dwell) and when constitutional amendments unlock. Lower it for a
# smaller founding window and earlier amendments; raise it for the opposite. Must
# be >= 2 (at 1 a lone founder would be a chartered electorate of one) and
# SOVEREIGN_AT must not undercut it.
DEMOCRACHAT_CHARTERING_AT=5
DEMOCRACHAT_SOVEREIGN_AT=25

# 64 hex chars (openssl rand -hex 32). Email addresses are ENCRYPTED at rest under
# this dedicated key — never stored in plaintext. Back it up separately; lose it
# and stored addresses are unrecoverable.
DEMOCRACHAT_EMAIL_KEY=

# SMTP submission relay for verification email. HOST is the mail/Postfix host's LAN
# address (it may be a different box than this app host — e.g. the edge Pi).
DEMOCRACHAT_SMTP_HOST=192.168.1.4
DEMOCRACHAT_SMTP_PORT=587
DEMOCRACHAT_SMTP_STARTTLS=true
DEMOCRACHAT_SMTP_USERNAME=no-reply@example.com
DEMOCRACHAT_SMTP_PASSWORD=
DEMOCRACHAT_SMTP_FROM=democrachat <no-reply@example.com>
# Set to 1 if the relay's submission TLS cert name doesn't match DEMOCRACHAT_SMTP_HOST.
DEMOCRACHAT_SMTP_INSECURE_TLS=

# Resource guards (a Pi 5 has 4 cores / 4–8 GB). Bump if the box is bigger.
APP_MEM=512m
APP_CPUS=2.0
APP_PIDS=256

# Override the built image tag if you build/push elsewhere.
IMAGE=democrachat:latest
