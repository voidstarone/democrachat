# APP HOST config. Copy to `.env` (git-ignored) and fill in.

# REQUIRED. Strong random session-signing secret (>= 16 chars; use 32+).
#   openssl rand -hex 32
# The app refuses to boot on this non-loopback bind if it is missing, a
# CHANGE_ME placeholder, or < 16 chars. If you ever run a second app host, it
# MUST use the exact same value so cookies verify across both.
DEMOCRACHAT_SESSION_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# REQUIRED. This host's LAN address that the edge host proxies to. Bind to the
# private interface, NOT 0.0.0.0 — the app must never be publicly reachable.
#   e.g. 10.0.0.4:3000   (a LAN ip) or 100.x.x.x:3000 (a WireGuard/tailnet ip)
APP_BIND=10.0.0.4:3000
